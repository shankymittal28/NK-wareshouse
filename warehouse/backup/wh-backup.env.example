# =====================================================================
# NK Warehouse backup — local secrets and paths for ONE machine.
#
# Copy this file to  wh-backup.env  BESIDE it, fill it in on the backup
# machine only, and lock it down:
#     Linux/macOS:  chmod 600 wh-backup.env
#     Windows:      right-click > Properties > Security, leave only your
#                   own user with access (or keep it in your user folder).
#
# This file is the ONLY place a secret lives. It is git-ignored, never
# printed, never copied into a backup set. The scheduler command never
# contains a secret — it only points here.
# =====================================================================

# The warehouse database connection string. Get it from the Supabase
# dashboard: Project Settings > Database > Connection string > URI, and
# paste your database password where it says [YOUR-PASSWORD].
# This credential is powerful — it is why this file must stay on this
# machine and nowhere else.
WH_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.enjlgflisuywkaorxetv.supabase.co:5432/postgres?sslmode=require"

# Where finished backup sets are staged on THIS machine (fast local disk).
WH_STAGING_DIR="C:/nk-warehouse-backup/staging"

# The OFFSITE destination: a folder that a sync app (OneDrive / Google
# Drive for Desktop) keeps copied off this machine. Losing or corrupting
# the Supabase project must not touch this folder. A plain local path here
# is NOT enough on its own — it must be inside a synced folder.
WH_OFFSITE_DIR="C:/Users/Mittal/OneDrive/nk-warehouse-backup"

# Evidence photographs live in Supabase Storage, which database backups do
# not include, so they are copied too. The service key is read only from
# here; it is the same kind of key the Tally pump already uses.
WH_STORAGE_URL="https://enjlgflisuywkaorxetv.supabase.co/storage/v1"
WH_STORAGE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
WH_BUCKET="wh-evidence"

# Keep this many days of sets. Older ones are pruned ONLY after a new set
# is safely offsite and verified.
WH_RETAIN_DAYS="30"

# Postgres client tools. Leave blank if pg_dump is on PATH; otherwise point
# at the bin folder, e.g. "C:/Program Files/PostgreSQL/17/bin".
PGBIN=""
